# Copy to docker/.env (or run docker/setup-env.sh robot|workstation, which detects most of
# these), or set them in the environment: the environment wins over this file.

# both
ROS_DOMAIN_ID=0
DISCOVERY_PORT=11811
HOST_UID=1000                 # id -u: the containers' user
HOST_GID=1000                 # id -g
INPUT_GID=                    # group of /dev/input/js0 on the host: stat -c %g /dev/input/js0
JOY_DEVICE=0
JOY_DEADZONE=0.166

# robot
SERIAL_DEVICE=/dev/ttyACM0    # better: the /dev/serial/by-id/... link of the servo board
SERIAL_GID=20                 # stat -c %g <SERIAL_DEVICE>
USE_MOCK_HARDWARE=false
LIMP=false
MARKER_MODE=free
MARKER_SPEED=0.08
ROBOT_JOY=false               # true: the joystick is plugged into the robot

# workstation
ROBOT_IP=                     # the robot's address: its discovery server
WORKSTATION_RVIZ=true
WORKSTATION_JOY=true          # false: the joystick is plugged into the robot
VIDEO_GID=                    # stat -c %g /dev/dri/card0
RENDER_GID=                   # stat -c %g /dev/dri/renderD128
XAUTHORITY_FILE=              # the X authority file ($XAUTHORITY, or ~/.Xauthority)
